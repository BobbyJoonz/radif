# ─── Radif — local development ────────────────────────────────────────────────
# Real PostgreSQL 17 running from .work/ (see scripts/pg-local.ps1).
DATABASE_URL="postgresql://radif:radif_dev@127.0.0.1:5433/radif?schema=public"
DATABASE_URL_TEST="postgresql://radif:radif_dev@127.0.0.1:5433/radif_test?schema=public"

# ─── mode ────────────────────────────────────────────────────────────────────
APP_MODE=demo
INGESTION_MODE=replay
DECISION_PROVIDER=mock
DRAFT_PROVIDER=none
OUTBOUND_MODE=preview
LIVE_AUTOMATION_ENABLED=false

# ─── provider credentials (empty in demo; nothing is sent anywhere) ──────────
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ─── auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# ─── at-rest sealing for channel tokens (AES-256-GCM, 32 bytes b64) ──────────
CHANNEL_TOKEN_ENC_KEY=replace-with-base64-32-bytes

# ─── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
WORKER_POLL_MS=1000
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_IMPORT_PER_MIN=5

